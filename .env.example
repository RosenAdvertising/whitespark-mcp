# Required: create this token in Local Ranking Grids under Profile → API Access.
WHITESPARK_API_TOKEN=replace-with-your-api-token

# Required: Whitespark's public beta guide does not publish the API base URL.
# Replace this placeholder with the exact base URL confirmed for your account.
WHITESPARK_API_BASE_URL=https://replace-with-confirmed-api-base.example

# Optional transport tuning. The vendor does not publish rate-limit details.
WHITESPARK_REQUEST_TIMEOUT_SECONDS=30
WHITESPARK_MAX_RETRIES=3
WHITESPARK_RETRY_BACKOFF_SECONDS=0.25

